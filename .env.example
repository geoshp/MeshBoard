# Скопируйте в .env и заполните. Файл .env не коммитится.
# Любую секретную переменную можно задать через файл: ИМЯ_FILE=/run/secrets/... (см. docker-compose.secrets.yml)

# ---------- Подключение к ноде ----------
# serial | tcp   (BLE не поддерживается)
MESHCORE_CONNECTION=tcp
# serial: путь к порту ВНУТРИ контейнера (в docker-compose.serial.yml проброшен как /dev/ttyMESH)
MESHCORE_SERIAL_PORT=/dev/ttyUSB0
MESHCORE_SERIAL_BAUDRATE=115200
# serial: устройство на хосте и его группа (stat -c %g /dev/ttyUSB0) — для docker-compose.serial.yml
MESHCORE_SERIAL_DEVICE=/dev/ttyUSB0
SERIAL_GID=dialout
# tcp: адрес companion-ноды с WiFi-прошивкой
MESHCORE_TCP_HOST=192.168.1.50
MESHCORE_TCP_PORT=5000
# 1 = встроенный эмулятор ноды (разработка без железа)
MESHCORE_MOCK=0
# множитель частоты событий эмулятора
MESHCORE_MOCK_SPEED=1

# ---------- Веб-интерфейс ----------
# ОБЯЗАТЕЛЬНО: пароль входа (не короче 8 символов)
MESHBOARD_PASSWORD=
# ключ подписи сессий; если пусто — случайный при каждом старте (сессии сбрасываются)
# сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
MESHBOARD_SECRET_KEY=
MESHBOARD_SESSION_HOURS=168
# 1 — если дашборд отдаётся через HTTPS (reverse proxy): cookie с флагом Secure
MESHBOARD_COOKIE_SECURE=0
# адрес публикации порта на хосте (docker compose). 127.0.0.1 — только локально
MESHBOARD_BIND=127.0.0.1
MESHBOARD_PUBLISH_PORT=8080
# адрес/порт, который слушает сам сервер (вне Docker по умолчанию 127.0.0.1:8080)
# MESHBOARD_HOST=127.0.0.1
# MESHBOARD_PORT=8080

# ---------- Данные ----------
# MESHBOARD_DATA_DIR=./data
MESHBOARD_RETENTION_MESSAGES_DAYS=90
MESHBOARD_RETENTION_METRICS_DAYS=30

# ---------- Опрос ----------
# метрики своей ноды, секунды (минимум 10)
MESHBOARD_SELF_POLL_SEC=60
# интервал опроса своих репитеров по умолчанию, минуты (меняется в интерфейсе)
MESHBOARD_REPEATER_POLL_MIN=15
# свои репитеры (начальное значение; дальше флаг меняется в интерфейсе): префиксы ключей через запятую
MESHBOARD_OWN_REPEATERS=
# пароли репитеров: по строке "префикс_ключа_или_имя=пароль" (лучше через MESHBOARD_REPEATER_PASSWORDS_FILE)
MESHBOARD_REPEATER_PASSWORDS=
# пароль для репитеров без явной записи (пусто = гостевой вход без пароля; не задано = не логиниться)
# MESHBOARD_REPEATER_DEFAULT_PASSWORD=

# ---------- Карта ----------
MESHBOARD_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MESHBOARD_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

MESHBOARD_LOG_LEVEL=INFO
